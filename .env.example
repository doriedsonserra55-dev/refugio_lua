# ==========================================
# REFÚGIO DA LUA - VARIÁVEIS DE AMBIENTE
# ==========================================

# 1. BANCO DE DADOS (Supabase PostgreSQL - Projeto: rrxrbvsplgcytnsszhzj)
# Obtenha a senha no painel do Supabase (https://supabase.com/dashboard/project/rrxrbvsplgcytnsszhzj/settings/database)
DATABASE_URL=postgresql://postgres.rrxrbvsplgcytnsszhzj:[SUA_SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# SUPABASE AUTH
# URL e chave publicável podem ser usadas no app. Nunca coloque a service role key no frontend.
EXPO_PUBLIC_SUPABASE_URL=https://rrxrbvsplgcytnsszhzj.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_SCHEME=manusrefugioapp
# No backend da Vercel, use a URL abaixo e a chave publicável/anon do projeto.
SUPABASE_URL=https://rrxrbvsplgcytnsszhzj.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# 2. SEGURANÇA & SESSÃO
# Defina uma chave secreta aleatória longa (mínimo 32 caracteres) para autenticação de sessão
JWT_SECRET=defina_uma_chave_secreta_longa_e_segura_aqui_123456789

# 3. URL DA API (Expo Public)
# Em produção na Vercel, pode ser deixado em branco se o frontend e backend estiverem no mesmo domínio da Vercel
EXPO_PUBLIC_API_BASE_URL=

# 4. CONFIGURAÇÕES OPCIONAIS DE OAUTH E IDENTIDADE
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_APP_ID=refugio-da-lua
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=Refúgio da Lua
OWNER_OPEN_ID=

# 5. RECUPERAÇÃO DE SENHA
# O envio é gerenciado pelo Supabase Auth. Configure os templates e SMTP no painel do Supabase.

NODE_ENV=production
